{
  "realm": "sure-iam-test",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "clients": [
    {
      "clientId": "iam-oidc-test",
      "name": "IAM OIDC Test Client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-oidc-client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:18080/iam/web/auth/callback/oidc"
      ],
      "webOrigins": [
        "http://localhost:18080"
      ]
    }
  ],
  "users": [
    {
      "username": "e2e-user",
      "enabled": true,
      "firstName": "E2E",
      "lastName": "User",
      "email": "e2e-user@sure-iam.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "local-oidc-user-password",
          "temporary": false
        }
      ]
    }
  ]
}
